<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://www.nuget.org/api/v2/" />
    <add key="Umbraco Prereleases" value="https://www.myget.org/F/umbracoprereleases/api/v3/index.json" />
    <add key="Umbraco Nightly" value="https://www.myget.org/F/umbraconightly/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- CMS prereleases are published to nuget.org and both MyGet feeds with different contents, so
         restoring them from more than one feed fails NuGet's package hash check (NU1403) -->
    <packageSource key="nuget.org">
      <package pattern="Umbraco.Cms.*" />
      <package pattern="Umbraco.*" />
      <package pattern="*" />
    </packageSource>
    <packageSource key="Umbraco Prereleases">
      <package pattern="Umbraco.Commerce.*" />
      <package pattern="Umbraco.*" />
    </packageSource>
    <packageSource key="Umbraco Nightly">
      <package pattern="Umbraco.Commerce.*" />
      <package pattern="Umbraco.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>